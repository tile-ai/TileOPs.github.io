@startuml call
skinparam defaultFontName "Noto Sans SC"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #6B5FA0
skinparam TitleFontColor #4A2C8F
skinparam sequenceMessageAlign left
skinparam maxMessageSize 125
skinparam BoxPadding 6
skinparam sequence {
  LifeLineBorderColor #CFC6E6
  ParticipantBorderColor #8E6CCF
  DividerBackgroundColor #F8F5FD
  DividerBorderColor #CFC6E6
  GroupBorderColor #8E6CCF
  GroupHeaderFontColor #4A2C8F
}
hide stereotype
skinparam participant<<sys>> {
  BackgroundColor #E2F6F8
  BorderColor #3AA9B8
}
skinparam participant<<dev>> {
  BackgroundColor #EFE9FA
  BorderColor #8E6CCF
}
box "开发者编写" #F8F5FD
  participant "Op 类\n_eager_forward" as op <<dev>>
end box
box "系统提供" #F3FBFC
  participant "Op 基类\nkernel_for" as base <<sys>>
  participant "CallSpec\n设备事实" as facts <<sys>>
end box
box "开发者编写" #F8F5FD
  participant "kernel 接口的\n实现" as impl <<dev>>
  participant "entry" as entry <<dev>>
end box

op -> op : 由张量与 op 的参数构造 call spec
op -> base : kernel_for(interface, call)
activate base
base -> base : 以 (interface, call)查派发缓存
alt 命中
  base --> op : 已解析的 entry
else 未命中
  base -> base : 检查 call 的类型与可哈希性
  loop 接口的每个实现
    base -> impl : unavailable(call)，可用时再问 refusal(call)
    impl -> facts : 读取 arch、sm_count、calibration、smem_budget
    facts -> facts : 首次读取时从 call.device 解析
    impl --> base : 理由，或 None
  end
  base -> base : 在可用且适用的实现中按优先关系取唯一胜者；key 被 kernel_map= 替换时，检查替换者能服务这次调用
  base -> impl : entry_for(call)
  impl --> base : (build identity, 构建函数)
  opt 这个 (实现类, build identity)\n尚未构建
    base -> entry : 以 call.device 为当前设备运行构建函数
  end
  base -> base : op 处于调参模式时对 entry 请求调参；写入派发缓存
  base --> op : entry
end
deactivate base
op -> entry : entry(张量)
entry --> op : 结果
@enduml
