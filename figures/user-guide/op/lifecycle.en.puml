@startuml lifecycle
title One op from class definition to the end of a call

skinparam defaultFontName "Noto Sans SC"
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1E293B
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam defaultFontSize 14
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 320
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3
skinparam sequence {
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #64748B
  ParticipantFontSize 15
  ParticipantFontStyle bold
  ActorBorderColor #64748B
  ActorBackgroundColor #FFFFFF
  DividerBackgroundColor #CBD5E6
  DividerBorderColor #64748B
  DividerFontSize 16
  DividerFontStyle bold
  GroupBorderColor #94A3B8
  GroupHeaderFontColor #0F172A
  GroupBackgroundColor #F1F5F9
}

actor "Caller" as caller
participant "op subclass" as sub #E9EAF0
participant "Op base class" as base #E9EAF0
participant "_SignaturePlan" as plan #E7EEF6
participant "_CompileBoundary" as cb #E7EEF6
participant "custom op" as cop #E7EEF6
participant "sub-op" as child #E9EAF0
participant "kernel\nimplementation class · entry" as kern #EEF2E6
participant "target's kernel" as tk #EEF2E6

== 1. Class definition: once per op class ==

caller -> sub : import the module, run the class statement
sub -> base : Op.~__init_subclass~__
opt the class has a manifest entry
  base -> plan : take the _signature every instance of the class shares
  base -> base : install the generated signature checks and output-shape inference;\ninstall eval_roofline when the entry has a roofline
  opt the entry has a call-time tensor input and no composition
    base -> cb : install the compile boundary
    cb -> cop : register a custom op per effect branch
    cb -> base : generate _call_boundary, set compile_op_names
  end
end
base -> base : record the manifest param names a target's builder is called with

== 2. Construction: once per op instance ==

caller -> sub : op = RMSNormFwdOp(...)
sub -> sub : settle the manifest params' values
sub -> base : super().~__init~__(target=target)
activate base
base -> base : store target
base -> base : step 1: load the backend registry
base -> plan : step 2: check the param values against the manifest
plan --> base : _construction_indices
base -> base : step 3: install the implementation table _installed_kernel_types, check the contracts;\nbuild the two entry caches
base -> base : step 4: register the instance, get _instance_key
base -> base : step 5: build the remaining empty fields of the binding and running groups
base --> sub
deactivate base
sub -> sub : build derived attributes
opt composite op
  sub -> base : delegate_for(stage, identity, ...)
  opt this (stage, identity) is not held yet
    base -> child : without given, build the sub-op, passing target;\nin tuned mode, call request_tune() on the newly held sub-op
  end
  base --> sub : the held sub-op; given is held as passed
end
sub --> caller : the op instance; no kernel selected or built

== 3. Call: every eager call on ordinary tensors ==

caller -> base : y = op(x, weight), that is Op.~__call~__
alt compile boundary (compile_op_names non-empty)
  base -> cop : the generated _call_boundary(...)
  cop -> base : look the instance up by _instance_key,\n_run_call(inputs, forward)
else no compile boundary
  base -> base : split the arguments by forward's signature,\n_run_call(inputs, forward)
end
activate base
base -> base : step 1: begin the call: push the call stack
base -> plan : step 2: check the signature
plan --> base : SignatureCall
alt step 3: at least one write, and every write holds no elements
  base -> base : step 5: build the result from the signature
else an implementation has to run
  opt step 4: the instance has no target yet
    base -> base : _bind_target: constructor argument → process default target → detect from the call device; with nothing to detect from, select none now and select at the next call
    break the selected target is not BUILTIN, registers no builder for the op,\nand the op declares kernels of its own
      base -> base : raise OpNotAvailableError;\npop the call stack, _reset_binding undoes the target selected now
      base --> caller : re-raise OpNotAvailableError; steps 5 and 6 do not run
    end
  end
  alt step 5: the selected target registered a builder for the op
    base -> base : look up the cache by device and each input's dtype and shape;\nan absent optional input holds its slot as None
    opt cache miss
      base -> tk : call the target's builder to build the kernel
    end
    base -> tk : kernel(tensors)
    tk --> base : result
  else step 5: no target builder
    base -> sub : forward(...)
    note right of sub : the two blocks below appear as the body is written:\neither may be absent, in either order
    opt the op declares kernels of its own
      sub -> base : kernel_for(interface, call)
      opt cache miss on (interface, call)
        base -> base : select the implementation
        base -> kern : implementation class.entry_for(call)
        kern --> base : identity and builder
        base -> base : look up built entries by (implementation class, identity);\nrun the builder on a miss
      end
      base --> sub : entry
      sub -> kern : entry(tensors)
      kern --> sub : result
    end
    opt composite op
      sub -> base : delegate_for(stage, identity, ...)
      opt this (stage, identity) is not held yet
        base -> child : without given, build the sub-op, passing target;\nin tuned mode, call request_tune() on the newly held sub-op
      end
      base --> sub : the held sub-op; given is held as passed
      sub -> child : sub-op(...), completing through the same seven steps
      child -> base : the sub-op reports its call record on completion
      child --> sub : result
    end
    sub --> base : result
  end
end
base -> plan : step 6: check the return value against the signature

== 4. End: every call ==

alt success
  base -> base : step 7: sub-op records into stages, by stage; pop the call stack;\nkeep as last_call; report to the enclosing call
  base --> caller : the result, returned through each caller that led into _run_call
else any step raises an Exception
  base -> base : pop the call stack, discard this call's record; last_call unchanged
  opt the target was selected in this call's step 4
    base -> base : _reset_binding: reset the binding group, drop the kernels built now
    base -> child : _reset_binding on every held sub-op, recursively
  end
  base --> caller : re-raise, propagating up through each caller
end
deactivate base

@enduml
