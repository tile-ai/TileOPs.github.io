@startuml structure
title Op class structure

skinparam defaultFontName "Noto Sans SC"
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1E293B
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam classBorderColor #64748B
skinparam classFontColor #0F172A
skinparam classFontStyle bold
skinparam classAttributeFontColor #334155
skinparam classStereotypeFontColor #64748B
skinparam classBorderThickness 1.5
skinparam arrowColor #64748B
skinparam arrowFontColor #475569
skinparam arrowThickness 1.3
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 45
skinparam classFontSize 15
skinparam classAttributeFontSize 14
skinparam arrowFontSize 16
hide empty members

abstract class Op #E9EAF0 {
    == <back:#CBD5E6> <b>Class attributes (one per op class)</b> </back> ==
    kernel_types : key → implementation class
    interfaces : interface → interface class
    delegate_types : stage → Op class
    injected_parameters
    compile_op_names
    _signature : _SignaturePlan (shared by the class's instances)
    == <back:#CBD5E6> <b>Instance state</b> </back> ==
    .. <i>construction</i> ..
    manifest params (construction-time tensors aside)
    target
    _installed_kernel_types : key → implementation class
    _preferred_over
    _keys_by_interface
    _construction_indices
    _instance_key
    .. <i>binding</i> ..
    _target_builder
    _serving_target
    _entries_by_call : (interface, call) → entry
    _built_entries : interface → entries
    _target_kernels : (device, each input's dtype, shape) → kernel
    .. <i>running</i> ..
    construction-time tensors
    _tune_requested
    _delegates : stage → identity → Op
    _delegate_stages
    _effect_branches
    _last_call : SignatureCall
    _tune_warned
    == <back:#CBD5E6> <b>Methods</b> </back> ==
    .. <i>external interface</i> ..
    __call__(*args) — the parameters are forward's
    serving_target «property»
    last_call «property»
    {abstract} <color:#2563EB>eval_roofline() «generated»</color>
    request_tune()
    kernel_config()
    iter_kernels()
    built_entries(interface)
    held_delegates()
    .. <i>internal interface</i> ..
    __init__(*, target=None)
    {abstract} <color:#DC2626>forward(...)</color>
    kernel_for(interface, call)
    key_for(interface, call)
    delegate_for(stage, identity, given=None, /, **params)
    roof_key()
    .. <i>implementation</i> ..
    __init_subclass__() — runs at class definition, installs the generated methods
    _run_call(inputs, body)
    _bind_target()
    _reset_binding()
    _get_or_build_entry(interface, call)
    _check_signature(tensors)
    {abstract} <color:#2563EB>_infer_output_shapes(...) «generated»</color>
}

class RMSNormFwdOp #E9EAF0 {
    kernel_types : 3 implementations
    interfaces : rms_norm
    --
    forward(x, weight=None)
}

class MoEExpertMLPFwdOp #E9EAF0 {
    delegate_types = {gate_up, down}
    --
    forward(expert_input, ...)
}

class _CompileBoundary #E7EEF6 {
    plan : _SignaturePlan
    branches : effect branch → custom op
    --
    call(op, inputs, writes, execution)
    build_call_boundary(cls) : the subclass's _call_boundary()
}

class _SignaturePlan #E7EEF6 {
    sig
    constructions
    checks
    shapes
    effects
    roofs
    --
    check_construction(op) : indices
    check(op, tensors) : SignatureCall
    output_shapes(op, shapes, dtypes)
    effect_branch(op, present)
    eval_roofline(call)
}

class SignatureCall <<dataclass, frozen>> #F7EEDC {
    indices
    branch_key
    device
    tensors
    traffic
    written
    has_out
    metadata
    stages : stage → SignatureCall*
    --
    metadata_values(name)
}

abstract class Kernel #EEF2E6 {
    devices
    supported_archs
    general
    preferred_over
    --
    refusal(call) [classmethod]
    entry_for(call) [classmethod]
    {abstract} <color:#DC2626>forward(...)</color>
}

abstract class KernelInterface #EEF2E6 {
    request : CallSpec
    --
    {abstract} <color:#DC2626>forward(...)</color>
}

abstract class RMSNormFwdInterface #EEF2E6 {
    request = LayerNormCall
    --
    {abstract} <color:#DC2626>forward(x, weight)</color>
}

object "entry" as Entry #EEF2E6 {
    A runtime object: on a cache miss,
    built by the builder the implementation class's entry_for returns
    one kernel or several kernels together
    here, one RMSNormOnChipKernel instance
}

class MoEGroupedGemmFwdOp <<Op subclass>> #E9EAF0 {
    forward(...)
}

class RMSNormOnChipKernel #EEF2E6 {
    supported_archs = [90]
    preferred_over = {rms_norm_streaming}
    --
    refusal(call) [classmethod]
}

' subclasses on top
RMSNormFwdOp -down-|> Op
MoEExpertMLPFwdOp -down-|> Op
MoEExpertMLPFwdOp o-right-> "2" MoEGroupedGemmFwdOp

' code generation below
Op .left.> _CompileBoundary
Op -down-> "0..1" _SignaturePlan
Op -down-> "0..1" SignatureCall : last_call
_CompileBoundary -right-> _SignaturePlan
_SignaturePlan .right.> SignatureCall

' kernels on the right
Op -right-> RMSNormOnChipKernel : "table[key]"
Op o-right-> "0..*" Entry
RMSNormOnChipKernel .down.> Entry
RMSNormOnChipKernel -up-|> Kernel
RMSNormOnChipKernel -right-|> RMSNormFwdInterface
RMSNormFwdInterface -up-|> KernelInterface

@enduml
