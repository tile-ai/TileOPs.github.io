@startuml execution
!pragma teoz true
skinparam defaultFontName "Noto Sans SC"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #5965C7
skinparam ArrowThickness 1.2
skinparam ParticipantBorderColor #4050B5
skinparam ParticipantBackgroundColor #AEB9EE
skinparam ParticipantFontColor #1F2A66
skinparam LifeLineBorderColor #7381A6
skinparam LifeLineBackgroundColor #F5F7FB
skinparam SequenceGroupBorderColor #7381A6
skinparam SequenceGroupBackgroundColor #F5F7FB
skinparam SequenceGroupHeaderFontColor #29334A
skinparam NoteBorderColor #7381A6
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteFontColor #242A52
hide footbox
title The order bench.Runner.compare() runs in

participant "runner : bench.Runner" as Runner
participant "workloads.numerics\n.verify()" as Verify <<function>>
participant "benchmarks.timing\n.bench_kernel()" as BenchKernel <<function>>

[-> Runner: compare({name: implementation})
Runner -> Runner: bind the TileOps op as tileops\nturn each comparison into an Implementation
Runner -> Runner: skip the reference against itself\nrecord noncomparable reasons

group Correctness check
  Runner -> Verify: verify(reference, inputs, evidence,\n{name: (run, args, reset)})
  Verify -> Verify: expected = reference(*inputs)\ncopied as the expected result
  loop each implementation to check
    Verify -> Verify: reset() if any
    Verify -> Verify: run(*args)
    Verify -> Verify: compare with expected\ncheck the shared inputs are unchanged
  end
  Verify -> Verify: release expected
  Verify --> Runner: dict[name, CheckResult]\nraises on any failure
end

group Timing: in the order A B C C B A, two passes sharing the budget
  Runner -> BenchKernel: bench_kernel(run, args, reset,\ncount_copies=case.count_copies)
  loop each iteration
    BenchKernel -> BenchKernel: reset() if any
    BenchKernel -> BenchKernel: flush L2
    BenchKernel -> BenchKernel: timed run(*args)
    BenchKernel -> BenchKernel: attribute this iteration's CUPTI records
  end
  BenchKernel --> Runner: list[Sample]
end

Runner -> Runner: aggregate samples, compute roofline, record the report
Runner -->[: {name: result}
@enduml
